{
  "name": "grounder-monorepo",
  "private": true,
  "description": "Monorepo for the Grounder CLI",
  "scripts": {
    "build": "pnpm --filter grounder build",
    "typecheck": "pnpm --filter grounder typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "test": "pnpm -r test",
    "demo:cast": "pnpm --filter @grounder/demo-casts build",
    "grounder": "node packages/grounder/dist/cli.js",
    "fixture:setup": "node scripts/fixture-setup.mjs",
    "e2e": "pnpm build && pnpm --filter @grounder/e2e e2e",
    "eval:search": "pnpm --filter @grounder/eval eval:search",
    "eval:mode-lock": "pnpm --filter @grounder/eval eval:mode-lock",
    "rules:fetch": "rulesync fetch andrej-kolic/playbook -f rules -t rulesync -p .rulesync",
    "rules:generate": "rulesync generate -f rules -t claudecode,cursor",
    "rules:install": "pnpm run rules:fetch && pnpm run rules:generate"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "rulesync": "16.24.1"
  }
}
