{
  "name": "grounder",
  "version": "0.6.0-dev.3",
  "description": "Connect projects to an Obsidian vault (or any markdown folder) for AI agent memory — session handoffs, plans, and notes in files you own",
  "type": "module",
  "bin": {
    "grounder": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "obsidian",
    "cursor",
    "claude-code",
    "handoff",
    "developer-tools",
    "ai",
    "cli",
    "agent-memory",
    "local-first",
    "vault",
    "session-handoff",
    "context-management",
    "second-brain",
    "pkm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrej-kolic/grounder.git",
    "directory": "packages/grounder"
  },
  "bugs": {
    "url": "https://github.com/andrej-kolic/grounder/issues"
  },
  "homepage": "https://github.com/andrej-kolic/grounder/tree/main/packages/grounder#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
